# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает (см. .gitignore).

# ─── База данных ────────────────────────────────────────────────────────────
# Строка подключения к Postgres проекта Supabase:
# Supabase → Project Settings → Database → Connection string → режим Session pooler.
# Выглядит так: postgres://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Секрет для подписи сессионной cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Хранилище фото (Supabase Storage) ──────────────────────────────────────
# Supabase → Project Settings → API. Бакет shift-photos должен быть приватным
# (без галочки Public). service_role-ключ используется только на сервере —
# в браузер он не попадает никогда.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Первый администратор (только для npm run db:seed) ──────────────────────
# После создания администратора эти переменные больше не нужны.
ADMIN_PHONE=
ADMIN_LAST_NAME=
ADMIN_FIRST_NAME=
# Если не указан — последние 4 цифры номера.
ADMIN_PIN=
