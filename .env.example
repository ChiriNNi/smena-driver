# Скопируйте этот файл в .env.local и заполните значения.

# Строка подключения к Postgres (Neon / Vercel Postgres). Пример Neon:
# postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Случайная секретная строка для подписи сессионной cookie администратора.
# Сгенерировать можно командой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
